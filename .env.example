# Copy to .env (never commit .env). On Cloud Run put these in Secret Manager.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/farebot
SESSION_SECRET=           # 32+ random characters
CRON_SECRET=              # random string; Cloud Scheduler sends it as "Authorization: Bearer ..."
IGNAV_API_KEY=            # ignav.com → API keys (main fare source)
SERPAPI_API_KEY=          # serpapi.com (optional, "Live check" button)
ANTHROPIC_API_KEY=        # console.anthropic.com (optional; without it search works, no AI text/tips)
ADMIN_USERNAME=admin      # first admin, created by `npm run seed`
ADMIN_PASSWORD=
ADMIN_NAME=Rohit
# Optional tuning
USD_TO_INR=88
IGNAV_USD_PER_CALL=0.002
SERPAPI_USD_PER_CALL=0
